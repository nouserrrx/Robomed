# ── Configuration Environnement RoBomed (RHMS) ──

# Sécurité Django
SECRET_KEY=django-insecure-production-super-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,robomed.org,api.robomed.org

# Base de données PostgreSQL (ou laissez vide pour SQLite local en dev)
DATABASE_URL=postgres://robomed_user:robomed_secure_pass_2026@localhost:5432/robomed_db
POSTGRES_DB=robomed_db
POSTGRES_USER=robomed_user
POSTGRES_PASSWORD=robomed_secure_pass_2026

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://robomed.org

# ── Configuration Email & SMTP Transactionnel ──
# Par défaut (sans identifiants), les emails s'affichent dans la console terminal (développement)
# Dès que EMAIL_HOST_USER est renseigné, le serveur bascule automatiquement sur l'envoi SMTP réel.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=robomedx@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application_16_caracteres
DEFAULT_FROM_EMAIL=RoBomed <robomedx@gmail.com>

# Exemples de serveurs SMTP :
# - Gmail : EMAIL_HOST=smtp.gmail.com | EMAIL_PORT=587 | TLS=True | Mot de passe d'application Google (16 car.)
# - Brevo (Sendinblue) : EMAIL_HOST=smtp-relay.brevo.com | EMAIL_PORT=587 | TLS=True
# - Mailjet : EMAIL_HOST=in-v3.mailjet.com | EMAIL_PORT=587 | TLS=True
# - SendGrid : EMAIL_HOST=smtp.sendgrid.net | EMAIL_PORT=587 | TLS=True | User=apikey

# ── Frontend API URL (Chemin relatif recommandé pour proxy Vite) ──
VITE_API_URL=/api

